# ==============================================================================
# PLANTILLA DE VARIABLES DE ENTORNO
# ==============================================================================
# Este archivo es SOLO documentación (está versionado, nunca contiene secretos).
#
# ATENCIÓN: no copies este archivo entero a .env.dev ni a .env.prod.
# Contiene DOS bloques y muchas variables se repiten con valores distintos;
# si copias todo, el último valor gana y arrancarías dev con settings de prod.
#
#   Para desarrollo  -> copia SOLO el bloque A a .env.dev
#   Para producción  -> copia SOLO el bloque B a .env.prod (en el VPS)
#
# Generación de secretos:
#   SECRET_KEY : docker compose run --rm web python -c \
#                "from django.core.management.utils import get_random_secret_key; \
#                 print(get_random_secret_key())"
#   Passwords  : openssl rand -hex 16
#
# IMPORTANTE: NO uses '$' en los valores. Docker Compose interpreta '$xxx' como
# interpolación de variable y mutila el valor. Usa hex/alfanumérico.
# ==============================================================================


# ==============================================================================
# BLOQUE A — DESARROLLO  (copiar a .env.dev)
# ==============================================================================

# --- Django ---
SECRET_KEY=django-insecure-unaclaveparadesarrollolocal
DEBUG=True
DJANGO_SETTINGS_MODULE=config.settings.dev
ALLOWED_HOSTS=127.0.0.1,localhost

# --- Base de datos (MySQL en Docker) ---
# Deben coincidir con lo que espera el servicio 'db' de docker-compose.dev.yml
DB_ENGINE=django.db.backends.mysql
DB_NAME=ecommerce_dev_db
DB_USER=dev_user
DB_PASS=changeme_db_password
DB_ROOT_PASSWORD=changeme_db_root_password
# 'db' es el nombre del SERVICIO de base de datos en docker-compose.dev.yml.
# No agregues comentarios en la misma línea: decouple los toma como parte del valor.
DB_HOST=db
DB_PORT=3306

# --- Variables que exige la imagen oficial de MySQL ---
DB_IMAGE_NAME=mysql:8.0
DB_CONTAINER_NAME=ecommerce-db-dev
WEB_CONTAINER_NAME=ecommerce-web-dev

# --- Email ---
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend


# ==============================================================================
# BLOQUE B — PRODUCCIÓN  (copiar a .env.prod en el VPS: /opt/ecommerce/.env.prod)
# ==============================================================================
# NUNCA versionar .env.prod (ya está en .gitignore).
#
# SECRET_KEY=<generar, sin '$'>
# DEBUG=False
# DJANGO_SETTINGS_MODULE=config.settings.prod
# ALLOWED_HOSTS=ecommerce.themattdev.com,www.ecommerce.themattdev.com
#
# --- Base de datos: Django (decouple) ---
# DB_ENGINE=django.db.backends.mysql
# DB_NAME=ecommerce_db
# DB_USER=ecommerce_user
# DB_PASS=<openssl rand -hex 16>
# DB_ROOT_PASSWORD=<openssl rand -hex 16>
# DB_HOST=db
# DB_PORT=3306
#
# --- Base de datos: imagen oficial mysql:8.0 (mismos valores que arriba) ---
# La imagen exige estos nombres. docker-compose.yml los inyecta vía env_file;
# no se pueden derivar con ${...} porque Compose no interpola desde env_file.
# MYSQL_DATABASE=ecommerce_db
# MYSQL_USER=ecommerce_user
# MYSQL_PASSWORD=<mismo valor que DB_PASS>
# MYSQL_ROOT_PASSWORD=<mismo valor que DB_ROOT_PASSWORD>
#
# --- Gunicorn ---
# GUNICORN_WORKERS=3
#
# --- Email (SMTP) ---
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
