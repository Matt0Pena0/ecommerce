# ==============================================================================
# Variables de Entorno — Plantilla de Producción
# ==============================================================================
# Archivo: /opt/ecommerce/.env.prod
#
# REGLAS:
#   - Este archivo NUNCA se versiona en Git (agregar a .gitignore)
#   - Cada proyecto tiene su propio .env.prod con credenciales únicas
#   - No reutilizar passwords entre proyectos
# ==============================================================================

# --- Proyecto ---
PROJECT_NAME=Ecommerce
ENVIRONMENT=production
DJANGO_SETTINGS_MODULE=config.settings.prod

# --- Base de Datos (MySQL 8.0) ---
DB_ENGINE=django.db.backends.mysql
DB_NAME=ecommerce_db
DB_USER=ecommerce_user
DB_PASS=<GENERAR_PASSWORD_SEGURO>
DB_ROOT_PASSWORD=<GENERAR_ROOT_PASSWORD_SEGURO>
DB_HOST=db
DB_PORT=3306

# --- Django ---
SECRET_KEY=<GENERAR_SECRET_KEY_DJANGO>
DEBUG=false
ALLOWED_HOSTS=ecommerce.themattdev.com

# --- Email (SMTP) ---
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
