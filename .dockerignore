# === Control de versiones ===
.git/
.gitignore

# === Python ===
__pycache__/
*.py[cod]
*$py.class
*.sqlite3
*.log

# === Entornos virtuales ===
.venv/
venv/
env/
ENV/

# === Secretos / entorno (nunca en la imagen) ===
.env
.env.*

# === Node (se reinstala en la etapa builder) ===
node_modules/

# === Artefactos generados (se regeneran en build/entrypoint) ===
staticfiles/
static/css/dist/
# NOTA: mediafiles/ NO se excluye. Se monta como bind mount y contiene las
# imágenes semilla versionadas (productos/producto.png, default del ImageField).


# === Datos persistentes de MySQL (viven en volumen, no en la imagen) ===
# NOTA: se excluye solo el directorio de datos de MySQL. Los fixtures
# versionados (data/backup.json, data/data.json) SÍ entran en la imagen
# para poder ejecutar `manage.py loaddata data/backup.json`.
data/mysql/

# === IDE / editor ===
.idea/
.vscode/

# === SDD / documentación de desarrollo ===
.agents/
.config/
.context/
.specs/
README.dev.md
apuntes.dev.md

# === Tests / coverage ===
.pytest_cache/
.coverage
htmlcov/

# === NOTA: pruebas_estres/ se incluye DELIBERADAMENTE ===
